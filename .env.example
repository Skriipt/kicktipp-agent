# Kicktipp credentials (optional — the CLI will prompt interactively if unset)
# Required when running the MCP server, which has no interactive prompt.
# Note: environment variables are visible to other users via `ps e`.
KICKTIPP_EMAIL=
KICKTIPP_PASSWORD=

# Optional: use the English host and routes instead of the default kicktipp.de.
# KICKTIPP_BASE_URL=https://www.kicktipp.com
