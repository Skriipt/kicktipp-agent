# Copy to .env.ha (gitignored). Fill only on your Docker host.
# Required: existing named [profile.<name>] account for Home Assistant.
KICKTIPP_PROFILE=
# Required for encrypted passwords: original saving container hostname.
# User must also match; compose.ha.yaml runs as node.
KICKTIPP_AUTH_HOSTNAME=
# Required: existing named config volume, or a dedicated copy prepared for HA.
KICKTIPP_AUTH_CONFIG_VOLUME=
# Loopback by default; use a specific private LAN IP for remote HA access.
KICKTIPP_HA_BIND_ADDRESS=127.0.0.1
KICKTIPP_HA_PORT=8787
# Keep reads and previews available; permit manual writes explicitly with 0.
KICKTIPP_READ_ONLY=1
