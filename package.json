{
  "name": "kicktipp-agent",
  "version": "1.3.0",
  "description": "Self-hosted Kicktipp service with MCP, reminders and CLI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skriipt/kicktipp-agent.git"
  },
  "homepage": "https://github.com/Skriipt/kicktipp-agent",
  "keywords": [
    "kicktipp",
    "mcp",
    "cli"
  ],
  "bin": {
    "kicktipp": "./dist/index.js",
    "kicktipp-mcp": "./dist/server.js",
    "kicktipp-agent-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/service/main.js",
    "setup": "node dist/setup-cli.js",
    "test:container": "docker compose build && node scripts/smoke-container.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.0.0",
    "commander": "^13.0.0",
    "ini": "^5.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/ini": "^4.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
