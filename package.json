{
  "name": "kicktipp-agent",
  "version": "1.1.1",
  "description": "CLI and MCP server for kicktipp.com and kicktipp.de",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianheidorn/kicktipp-agent.git"
  },
  "homepage": "https://kicktipp-agent.com",
  "keywords": [
    "kicktipp",
    "mcp",
    "cli"
  ],
  "bin": {
    "kicktipp": "./dist/index.js",
    "kicktipp-mcp": "./dist/server.js",
    "kicktipp-agent-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "mcpb/manifest.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mcpb": "bash scripts/pack-mcpb.sh",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cheerio": "^1.0.0",
    "commander": "^13.0.0",
    "ini": "^5.0.0",
    "ora": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/ini": "^4.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
