{
  "name": "kicktipp-agent",
  "version": "1.3.0",
  "description": "CLI and MCP server for kicktipp.com and kicktipp.de",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skriipt/kicktipp-agent.git"
  },
  "homepage": "https://github.com/Skriipt/kicktipp-agent",
  "keywords": [
    "kicktipp",
    "mcp",
    "cli"
  ],
  "bin": {
    "kicktipp": "./dist/index.js",
    "kicktipp-mcp": "./dist/server.js",
    "kicktipp-agent-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "mcpb/manifest.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "build": "node scripts/build.mjs",
    "dashboard": "node dist/index.js dashboard",
    "test": "vitest run",
    "test:docker": "bash scripts/docker-smoke.sh",
    "test:watch": "vitest",
    "pack:mcpb": "bash scripts/pack-mcpb.sh",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "ini": "^7.0.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/ini": "^4.1.0",
    "@types/node": "^22.20.1",
    "domhandler": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "cheerio": {
      "encoding-sniffer": "^1.0.2"
    }
  }
}
